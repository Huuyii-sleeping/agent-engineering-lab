{
  "name": "agent-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @orbit/runtime-contracts build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "predev": "pnpm --filter @orbit/runtime-contracts build",
    "dev": "tsx src/main.ts",
    "start:server": "node dist/service-api/server.js",
    "dev:server": "tsx src/service-api/server.ts",
    "start:mcp-server": "node dist/main.js mcp-server",
    "dev:mcp-server": "tsx src/main.ts mcp-server",
    "start:tui": "node dist/main.js tui",
    "dev:tui": "tsx src/main.ts tui",
    "start:tui-ink": "node dist/main.js tui-ink",
    "dev:tui-ink": "tsx src/main.ts tui-ink",
    "test:regression": "tsx test/smoke/prd13-regression.ts",
    "test:security": "tsx test/smoke/prd07-security-smoke.ts",
    "test:memory": "vitest run test/unit/mastra/memory test/unit/tools/tool-execution-port.test.ts --no-cache",
    "test:observability": "tsx test/smoke/prd09-observability-smoke.ts",
    "test:hooks": "vitest run test/unit/services/hook-service.test.ts --no-cache",
    "test:recovery": "vitest run test/unit/recovery.test.ts test/unit/mastra/adapters/workflow-runtime-adapter.test.ts --no-cache",
    "test:scheduler": "vitest run test/unit/scheduler.test.ts test/unit/tools/scheduler-cron.test.ts test/unit/tools/scheduler-store.test.ts --no-cache",
    "test:workflow": "vitest run test/unit/mastra/workflows test/unit/mastra/adapters/workflow-runtime-adapter.test.ts test/smoke/mastra-only-release-window.test.ts --no-cache",
    "test:worktree-closeout": "tsx test/smoke/prd18-worktree-smoke.ts",
    "test:mcp": "vitest run test/unit/entrypoints/mcp-server.test.ts test/unit/mcp.test.ts test/unit/tools/mcp-registry.test.ts --no-cache",
    "test:delivery": "tsx test/smoke/prd10-delivery-smoke.ts",
    "test:model-policy": "tsx test/smoke/prd11-model-policy-smoke.ts",
    "test:service-api": "vitest run test/unit/agent-service.test.ts test/unit/service-api test/smoke/nest-host-compatibility.test.ts --no-cache",
    "test:daemon": "tsx test/smoke/prd20-daemon-control-smoke.ts",
    "test:ink-tui": "tsx test/smoke/prd80-ink-tui-smoke.ts",
    "test:harness": "vitest run test/unit/harness test/smoke/runtime-port-contracts.test.ts --no-cache",
    "replay:trace": "tsx src/observability/replay-cli.ts",
    "pretest": "pnpm --filter @orbit/runtime-contracts build",
    "test": "vitest run --no-cache",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" \"*.json\" \"*.md\"",
    "release:check": "tsx test/smoke/release-gate.ts"
  },
  "dependencies": {
    "@mastra/core": "1.52.1",
    "@mastra/libsql": "1.17.0",
    "@mastra/memory": "1.23.1",
    "@mastra/nestjs": "0.2.9",
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@orbit/runtime-contracts": "workspace:*",
    "@orbit/workflow-core": "workspace:*",
    "dotenv": "^17.2.0",
    "express": "5.1.0",
    "ink": "^7.0.3",
    "openai": "^6.0.0",
    "pino": "^9.3.2",
    "react": "^19.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "eslint": "^9.8.0",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.2.0",
    "vitest": "^2.0.5"
  },
  "packageManager": "pnpm@10.18.3+sha512.bbd16e6d7286fd7e01f6b3c0b3c932cda2965c06a908328f74663f10a9aea51f1129eea615134bf992831b009eabe167ecb7008b597f40ff9bc75946aadfb08d"
}
