{
  "name": "agent-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "start:server": "node dist/server.js",
    "dev:server": "tsx src/server.ts",
    "test:regression": "tsx test/smoke/prd13-regression.ts",
    "test:security": "tsx test/smoke/prd07-security-smoke.ts",
    "test:memory": "tsx test/smoke/prd08-memory-smoke.ts",
    "test:observability": "tsx test/smoke/prd09-observability-smoke.ts",
    "test:hooks": "tsx test/smoke/prd14-hooks-smoke.ts",
    "test:recovery": "tsx test/smoke/prd16-recovery-smoke.ts",
    "test:scheduler": "tsx test/smoke/prd17-scheduler-smoke.ts",
    "test:worktree-closeout": "tsx test/smoke/prd18-worktree-smoke.ts",
    "test:mcp": "tsx test/smoke/prd19-mcp-smoke.ts",
    "test:delivery": "tsx test/smoke/prd10-delivery-smoke.ts",
    "test:model-policy": "tsx test/smoke/prd11-model-policy-smoke.ts",
    "test:service-api": "tsx test/smoke/prd12-service-api-smoke.ts",
    "replay:trace": "tsx src/observability/replay-cli.ts",
    "test": "vitest run --no-cache",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"*.md\"",
    "release:check": "pnpm lint && pnpm test && pnpm build && pnpm test:security && pnpm test:memory && pnpm test:observability && pnpm test:delivery && pnpm test:model-policy && pnpm test:service-api && pnpm test:regression && pnpm test:hooks && pnpm test:recovery && pnpm test:scheduler && pnpm test:worktree-closeout && pnpm test:mcp"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "openai": "^6.0.0",
    "pino": "^9.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.8.0",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.2.0",
    "vitest": "^2.0.5"
  },
  "packageManager": "pnpm@10.18.3+sha512.bbd16e6d7286fd7e01f6b3c0b3c932cda2965c06a908328f74663f10a9aea51f1129eea615134bf992831b009eabe167ecb7008b597f40ff9bc75946aadfb08d"
}
