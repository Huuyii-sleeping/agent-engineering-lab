{
  "name": "agent-bff",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "predev": "pnpm --filter @orbit/runtime-contracts build",
    "dev": "tsx src/main.ts",
    "prebuild": "pnpm --filter @orbit/runtime-contracts build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "pretest": "pnpm --filter @orbit/runtime-contracts build",
    "test": "vitest run --no-cache",
    "sops:health": "tsx src/sops/sops-admin.ts health",
    "sops:backup": "tsx src/sops/sops-admin.ts backup",
    "sops:restore": "tsx src/sops/sops-admin.ts restore"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "@orbit/runtime-contracts": "workspace:*",
    "@orbit/workflow-core": "workspace:*",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "better-sqlite3": "12.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
