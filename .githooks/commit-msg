#!/bin/sh

msg_file="$1"
first_line="$(sed -n '1p' "$msg_file")"

# Allow merge commits generated by Git.
case "$first_line" in
  Merge\ * ) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._/-]+\))?(!)?: .+'

echo "$first_line" | grep -Eq "$pattern"
if [ $? -ne 0 ]; then
  echo "Invalid commit message format."
  echo "Expected: <type>(<scope>): <subject>"
  echo "Example: feat(auth): support oauth login"
  exit 1
fi

exit 0

