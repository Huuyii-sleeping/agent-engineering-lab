{
  "name": "agent-engineering-lab",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "pnpm dev:agent",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "release:check": "pnpm --filter agent-cli release:check",
    "dev:agent": "pnpm --filter agent-cli dev",
    "build:agent": "pnpm --filter agent-cli build",
    "start:agent": "pnpm --filter agent-cli start",
    "dev:bff": "pnpm --filter agent-bff dev",
    "build:bff": "pnpm --filter agent-bff build",
    "test:bff": "pnpm --filter agent-bff test",
    "dev:skill-registry": "pnpm --filter skill-registry dev",
    "build:skill-registry": "pnpm --filter skill-registry build",
    "test:skill-registry": "pnpm --filter skill-registry test",
    "docker:skill-registry": "docker compose -f compose.skill-registry.yaml up --build",
    "dev:web": "pnpm --filter agent-web-console dev",
    "build:web": "pnpm --filter agent-web-console build"
  }
}
